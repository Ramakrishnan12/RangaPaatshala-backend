{
  "name": "typescript-backend-app",
  "version": "1.0.0",
  "description": "A TypeScript backend application with Express and MongoDB",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts && npm run build && node dist/app.js",
    "build": "tsc",
    "dev": "ts-node-dev src/app.ts",
    "start:watch": "tsc && ts-node-dev --respawn src/app.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.18.0",
    "mongoose": "^5.10.9",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/mongodb": "^4.0.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "author": "",
  "license": "ISC"
}
